# Deployed as .shellcheckrc.
#
# Both settings give shellcheck information rather than taking findings away.
# The disables this replaced — SC2155, SC1091, SC1090 in font and theme — hid
# six real SC2155s per repo: `local x=$(cmd)` masks the command's exit status
# behind local's own, so a failure reads as success.
#
# Do not add a `disable=` line to this file — it is copied to every repo, so a
# disable written here turns a rule off fleet-wide to satisfy one caller.
#
# A repo that genuinely needs an exception declares it as
# toolchain.shellcheck_disable in the registry, with the reason attached; the
# sync die appends it below this block. That keeps the exception scoped to the
# repo, recorded where the rest of its toolchain is declared, and readable
# without grepping the tree for inline directives. homelab is the standing
# example: its deploy scripts interpolate local variables into remote ssh
# commands 53 times, and SC2029 flags every one of them.
#
# A source shellcheck genuinely cannot follow (a system file, an installed path
# outside the repo) still takes a per-line `# shellcheck source=/dev/null` at
# the site, which stays scoped to the one thing that is actually unresolvable.

# Follow a sourced file instead of reporting SC1091 and checking nothing in it.
external-sources=true

# Resolve a `source=` directive against the sourcing file rather than the
# working directory, so tests/ can name ../lib/x.sh and lint identically from
# anywhere. Without it the same file passes or fails depending on the cwd.
source-path=SCRIPTDIR
